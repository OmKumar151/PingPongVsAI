############################################
# UNITY PROJECT
############################################

# This .gitignore is tailored for Unity projects

[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
UserSettings/

# MemoryCaptures can get excessive in size
MemoryCaptures/

# Asset meta data (keep this!)
!/[Aa]ssets/**/*.meta
!/[Pp]rojectSettings/**/*.meta

# Autogenerated VS/MD/Consulo solution and project files
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity cache
*.apk
*.aab
*.unitypackage

############################################
# VISUAL STUDIO
############################################

.vs/
*.rsuser
*.userosscache
*.sln.docstates

############################################
# OS GENERATED FILES
############################################

.DS_Store
Thumbs.db

############################################
# LOGS
############################################

*.log

############################################
# NODE (if used)
############################################

node_modules/

############################################
# OPTIONAL (uncomment if needed)
############################################

# Builds
# /Builds/

# Addressables
# /Assets/AddressableAssetsData/*/*.bin*